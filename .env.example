# =====================================================
# RaahPrahari - FRONTEND environment variables
# Copy karo:  cp .env.example .env.local   (Windows: copy .env.example .env.local)
# Is file me KABHI asli value mat likhna.
#
# WARNING: VITE_ se shuru hone wale variables browser me PUBLIC ho jate hain.
# Yahan koi secret (service_role key, API secret) NAHI jayega.
# =====================================================

# Kaunsa environment: development | demo | pilot | production
VITE_APP_ENV=

# Supabase project URL (Supabase dashboard > Project Settings > API)
VITE_SUPABASE_URL=

# Supabase ANON / PUBLISHABLE key (ye public key hai, RLS ke bharose safe)
VITE_SUPABASE_ANON_KEY=